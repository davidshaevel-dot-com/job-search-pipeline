# Environment Variables for Job Search Pipeline
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to git - it contains secrets

# =============================================================================
# Phase 1 - Job Search (JSearch API via RapidAPI) - REQUIRED
# =============================================================================
# Get your key from: https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
RAPIDAPI_KEY=your-rapidapi-key-here

# =============================================================================
# Phase 3 - AI Evaluation (Claude API) - REQUIRED for job evaluation
# =============================================================================
# Get your key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# =============================================================================
# Phase 4 - Multi-Board Support (will be needed in Phase 4)
# =============================================================================
# Adzuna API - https://developer.adzuna.com/
ADZUNA_APP_ID=your-adzuna-app-id
ADZUNA_APP_KEY=your-adzuna-app-key

# The Muse API - https://www.themuse.com/developers/api/v2
THEMUSE_API_KEY=your-themuse-api-key

# USAJobs API - https://developer.usajobs.gov/
USAJOBS_API_KEY=your-usajobs-api-key
USAJOBS_USER_AGENT=your-email@example.com

# =============================================================================
# Phase 5 - Notifications & Tracking (will be needed in Phase 5)
# =============================================================================
# Slack Integration - https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token

# Linear API - https://linear.app/settings/api
LINEAR_API_KEY=lin_api_your-linear-api-key

# =============================================================================
# Phase 6 - Cloud Deployment (will be needed in Phase 6)
# =============================================================================
# GCP for Cloud Run deployment
# Path to your GCP service account JSON file
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/service-account.json
